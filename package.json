{
  "name": "react-grids-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build -w @react-grids-playground/tanstack-grid && vite build",
    "build:app": "vite build",
    "preview": "vite preview",
    "test:package": "npm run test -w @react-grids-playground/tanstack-grid",
    "typecheck:package": "npm run typecheck -w @react-grids-playground/tanstack-grid"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-grids-playground/tanstack-grid": "file:packages/tanstack-grid",
    "@syncfusion/ej2-react-grids": "^33.2.12",
    "@tanstack/react-table": "^8.21.3",
    "antd": "^6.3.6",
    "cldr-data": "^36.0.5",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-intl": "^10.1.13",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.14"
  }
}
